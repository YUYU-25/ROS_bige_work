<?xml version="1.0"?>
<package format="3">
  <name>yuyu_bringup</name><version>0.1.0</version>
  <description>YUYU desktop companion robot, original ROS 2 Humble simulation.</description>
  <maintainer email="maintainer@example.com">YUYU project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>fonts-noto-cjk</exec_depend>
  <exec_depend>espeak</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
