<?xml version="1.0"?>
<package format="3">
  <name>yuyu_description</name><version>0.1.0</version>
  <description>YUYU desktop companion robot, original ROS 2 Humble simulation.</description>
  <maintainer email="maintainer@example.com">YUYU project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <export><build_type>ament_python</build_type><gazebo_ros gazebo_model_path="${prefix}/.."/></export>
</package>
