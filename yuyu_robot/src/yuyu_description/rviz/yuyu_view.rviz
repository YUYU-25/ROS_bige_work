Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 35; 43
    Fixed Frame: base_footprint
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.005
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 90; 190; 230
      Alpha: 0.6
    - Class: rviz_default_plugins/Path
      Name: Navigation Path
      Enabled: true
      Topic:
        Value: /plan
      Color: 70; 200; 255
      Line Width: 0.004
    - Class: rviz_default_plugins/Path
      Name: Dance Path
      Enabled: true
      Topic:
        Value: /dance_path
        Durability Policy: Transient Local
      Color: 255; 100; 180
      Line Width: 0.004
    - Class: rviz_default_plugins/Map
      Name: Desk Boundary Map
      Enabled: false
      Topic:
        Value: /desk_map
        Durability Policy: Transient Local
      Alpha: 0.5
    - Class: rviz_default_plugins/Image
      Name: Face
      Enabled: true
      Topic:
        Value: /face_image
        Reliability Policy: Reliable
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.6
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.08}
      Pitch: 0.35
      Yaw: 0.65
      Target Frame: base_footprint
Window Geometry:
  Width: 1200
  Height: 800
