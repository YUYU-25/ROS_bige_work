@@ -0,0 +1,83 @@
+"""A cancelled browser request must not crash/log the HTTP worker or resubmit a command."""
+import json
+from pathlib import Path
+import socket
+import struct
+import sys
+import tempfile
+import threading
+import unittest
+import urllib.request
+from http.server import ThreadingHTTPServer
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'src/yuyu_bringup'))
+from yuyu_bringup.panel import PanelApplication, make_handler
+
+
+class DisconnectTests(unittest.TestCase):
+    def test_reset_during_headers_or_body_keeps_server_usable(self):
+        for route in ('/api/face.png', '/api/command'):
+            for stage in ('headers', 'body'):
+                with self.subTest(route=route, stage=stage), tempfile.TemporaryDirectory() as root:
+                    ready, resume, finished = (threading.Event() for _ in range(3))
+                    errors, effects = [], []
+                    app = PanelApplication(lambda *args: effects.append(args), root)
+                    base = make_handler(app, Path(__file__).resolve().parents[1]/'src/yuyu_bringup/web')
+
+                    class Handler(base):
+                        def end_headers(self):
+                            if self.path == route and stage == 'headers':
+                                ready.set()
+                                if not resume.wait(3):
+                                    raise RuntimeError('test did not release header writer')
+                            super().end_headers()
+                            if self.path == route and stage == 'body':
+                                ready.set()
+                                if not resume.wait(3):
+                                    raise RuntimeError('test did not release body writer')
+
+                    class Server(ThreadingHTTPServer):
+                        daemon_threads = True
+
+                        def handle_error(self, request, client_address):
+                            errors.append(sys.exc_info()[0])
+
+                        def process_request_thread(self, request, client_address):
+                            try:
+                                super().process_request_thread(request, client_address)
+                            finally:
+                                finished.set()
+
+                    server = Server(('127.0.0.1', 0), Handler)
+                    thread = threading.Thread(target=server.serve_forever, daemon=True)
+                    thread.start()
+                    client = socket.create_connection(server.server_address, timeout=3)
+                    try:
+                        payload = json.dumps({'text': '过来', 'id': 'cancelled-response'}).encode()
+                        headers = (f'POST {route} HTTP/1.0\r\nHost: 127.0.0.1\r\n'
+                                   f'X-Yuyu-Token: {app.token}\r\nContent-Type: application/json\r\n'
+                                   f'Content-Length: {len(payload)}\r\n\r\n').encode()
+                        request = (headers+payload if route == '/api/command' else
+                                   b'GET /api/face.png HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n')
+                        client.sendall(request)
+                        self.assertTrue(ready.wait(3), 'HTTP response did not reach expected stage')
+                        client.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
+                        client.close()
+                        resume.set()
+                        self.assertTrue(finished.wait(3), 'cancelled response did not finish')
+                        self.assertEqual(errors, [])
+                        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+                        with opener.open('http://127.0.0.1:%d/api/state' % server.server_port,
+                                         timeout=3) as response:
+                            self.assertIn('settings', json.load(response))
+                        self.assertEqual(len(effects), int(route == '/api/command'))
+                    finally:
+                        client.close()
+                        resume.set()
+                        server.shutdown()
+                        server.server_close()
+                        thread.join(timeout=3)
+
+
+if __name__ == '__main__':
+    unittest.main()
