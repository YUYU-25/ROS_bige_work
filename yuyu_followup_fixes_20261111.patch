diff --git a/tests/test_emotion_rules.py b/tests/test_emotion_rules.py
new file mode 100644
index 0000000..0b3fbd8
--- /dev/null
+++ b/tests/test_emotion_rules.py
@@ -0,0 +1,46 @@
+"""Regression sentences for negated feelings and explicit command priority."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'src/yuyu_bringup'))
+from yuyu_bringup.core import interpret
+
+
+class EmotionRuleTests(unittest.TestCase):
+    def test_unhappy_is_never_read_as_happy(self):
+        for text in ('很不开心', '我很不开心', '我今天不太开心', '一点也不高兴',
+                     '我并不觉得开心', '没那么开心', '我开心不起来', '高兴不了',
+                     '开心才怪', '从来没这么不开心过'):
+            with self.subTest(text=text):
+                self.assertEqual(interpret(text), (None, 'annoyed'))
+
+    def test_genuinely_happy_sentences_remain_happy(self):
+        for text in ('今天很开心', '我好高兴', '从来没有这么开心过',
+                     '从未如此高兴', '不是一般的开心'):
+            with self.subTest(text=text):
+                self.assertEqual(interpret(text), (None, 'happy'))
+
+    def test_negated_or_ambiguous_feeling_does_not_resume_speech(self):
+        for text in ('我不难过', '不太累', '我不烦', '不是不开心', '没有不高兴',
+                     '你开不开心', '今天开心吗', '我在吃开心果'):
+            with self.subTest(text=text):
+                self.assertEqual(interpret(text), (None, None))
+
+    def test_later_explicit_feeling_handles_corrections(self):
+        for text, expected in (('刚才不开心，不过现在很开心', 'happy'),
+                               ('本来开心，但现在很难过', 'annoyed'),
+                               ('我很烦，不过不累', 'annoyed'),
+                               ('不是不开心，只是累了', 'tired')):
+            with self.subTest(text=text):
+                self.assertEqual(interpret(text), (None, expected))
+
+    def test_motion_and_quiet_commands_keep_priority(self):
+        self.assertEqual(interpret('过来陪我，我不开心'), ('come', 'annoyed'))
+        self.assertEqual(interpret('我不开心，别跳舞了'), ('stop', 'annoyed'))
+        self.assertEqual(interpret('我不开心，不想说话，安静'), ('stop', 'silent'))
+        self.assertEqual(interpret('恢复说话'), (None, 'none'))
+
+
+if __name__ == '__main__':
+    unittest.main()
