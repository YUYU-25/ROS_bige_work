 """不依赖 ROS 的规则、几何与防护逻辑，便于独立验证。"""
 import math
+import re
 
 CLIFF_NAMES = ('front_left', 'front_right', 'rear_left', 'rear_right')
 MAX_WHEEL_RAD_S = 2.8
@@ -7,6 +8,37 @@ DEFAULT_SPEED = 0.05
 DANCE_MARGIN = 0.145
 SCAN_SELF_RADIUS = 0.13
 
+_MOOD_WORD = re.compile(r'开心(?!果)|高兴|难过|烦躁|烦|累')
+_MOOD_QUESTION = re.compile(r'开不开心|高不高兴|难不难过|烦不烦|累不累')
+_NEGATORS = r'没有|不是|并非|不算|谈不上|不能|不|没|别'
+_NEGATED_MOOD_PREFIX = re.compile(
+    rf'(?:(?:{_NEGATORS})(?:太|很|那么|怎么|特别|十分|非常|真的|真|再|'
+    r'觉得|感到|感觉|想|会|能|什么|一点|也|就|这么|多|法|得|可能)*)+$')
+_MOOD_SUPERLATIVE = re.compile(r'从(?:来)?(?:没有|没|未)(?:这么|那么|如此)(?:地)?')
+
+
+def _feeling(text):
+    """Recognize simple feeling statements with local negation, not general conversation."""
+    text = _MOOD_QUESTION.sub('，', re.sub(r'\s+', '', text))
+    result = None
+    for match in _MOOD_WORD.finditer(text):
+        word, tail = match.group(), text[match.end():]
+        if tail.startswith(('吗', '么', '嘛', '?', '？')):
+            continue
+        # “从没这么开心过”否定的是过去的程度，而不是现在的开心。
+        prefix = _MOOD_SUPERLATIVE.sub('', text[:match.start()])
+        negated = _NEGATED_MOOD_PREFIX.search(prefix)
+        count = len(re.findall(_NEGATORS, negated.group())) if negated else 0
+        count += int(tail.startswith(('不起来', '不了', '才怪', '个鬼', '个屁')))
+        if count > 1:
+            # 双重否定不直接推断为开心；也不能返回恢复说话专用的“none”。
+            continue
+        if word in ('开心', '高兴'):
+            result = 'annoyed' if count else 'happy'
+        elif not count:
+            result = 'tired' if word == '累' else 'annoyed'
+    return result
+
 
 def scan_without_body(ranges, range_max):
     """Keep external measurements unchanged; mask returns inside the body disk."""
